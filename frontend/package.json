{
  "name": "vue-admin-template",
  "version": "5.0.0",
  "description": "A vue admin template with Element Plus & axios & iconfont & permission control & lint",
  "author": "Pan <panfree23@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean-dev": "npm run clean && npm run dev",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "npx rimraf dist node_modules/.vite",
    "clean-all": "npx rimraf dist node_modules package-lock.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueup/vue-quill": "1.2.0",
    "axios": "1.7.7",
    "crypto-js": "4.2.0",
    "dompurify": "^3.4.3",
    "echarts": "5.5.0",
    "element-plus": "2.8.6",
    "fast-glob": "^3.3.3",
    "html2canvas": "1.4.1",
    "js-cookie": "3.0.5",
    "jspdf": "2.5.1",
    "jwt-decode": "4.0.0",
    "mitt": "3.0.1",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "path-browserify": "1.0.1",
    "path-to-regexp": "6.2.1",
    "pinia": "2.2.1",
    "vue": "3.4.38",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "9.9.0",
    "@rushstack/eslint-patch": "1.10.4",
    "@types/node": "20.14.2",
    "@vitejs/plugin-vue": "4.6.2",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.9.0",
    "eslint-plugin-vue": "9.27.0",
    "globals": "15.9.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "1.60.0",
    "vite": "4.5.2",
    "vite-plugin-svg-icons": "2.0.1",
    "vitest": "1.6.0",
    "vuex": "4.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.8.2"
  },
  "license": "MIT"
}
