<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承 Spring Boot 父项目，提供默认的依赖版本管理和构建配置 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.0.13</version>
	</parent>

	<!-- 项目基本信息 -->
	<groupId>cn.org.wang</groupId>
	<artifactId>exam</artifactId>
	<version>1.0-SNAPSHOT</version>

	<!-- 项目属性配置 -->
	<properties>
		<!-- Java 版本 -->
		<java.version>17</java.version>
		<!-- 项目构建源文件编码 -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- 项目报告输出编码 -->
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- 版本管理 -->
		<mybatis-plus.version>3.5.6</mybatis-plus.version>
		<springdoc.version>2.2.0</springdoc.version>
		<ip2region.version>2.6.5</ip2region.version>
		<lombok.version>1.18.30</lombok.version>
		<mapstruct.version>1.5.5.Final</mapstruct.version>

		<!-- 指定本地 SonarQube 服务器地址 -->
    	<sonar.host.url>http://localhost:9000</sonar.host.url>
    	<!-- 显式启用 PMD 插件规则 -->
    	<sonar.java.pmd.enable>true</sonar.java.pmd.enable>

		<!-- SpotBugs 配置：通过 -Dspotbugs.skip=true 参数可跳过 SpotBugs 检查 -->
		<spotbugs.skip>false</spotbugs.skip>
	</properties>

	<!-- 项目依赖配置 -->
	<dependencies>
		<!--  Spring Boot Starters (核心框架)  -->
		<!-- Spring Boot Web Starter: 提供构建Web应用程序的核心功能，包括嵌入式Tomcat服务器、Spring MVC框架、JSON支持等 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Spring Boot Security Starter: 提供应用程序安全功能，包括身份验证、授权、密码加密、CSRF保护等 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Spring Boot Data Redis Starter: 提供Redis数据库的集成支持，用于缓存、会话管理、消息队列等 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<!--对象池管理工具类 redis连接池配置所需 -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-pool2</artifactId>
		</dependency>
		<!-- Spring Boot AOP Starter: 提供面向切面编程支持，用于实现日志记录、事务管理、性能监控等横切关注点 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>
		<!-- Spring Boot WebSocket Starter: 提供WebSocket协议支持，用于实现实时双向通信，如聊天、通知推送等 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<!-- Spring Boot Test Starter: 提供单元测试和集成测试支持，包括JUnit、Mockito、Spring测试上下文等 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Mockito Inline: 支持静态方法Mock -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-inline</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Spring Boot DevTools: 开发工具，提供热部署功能，修改代码后无需重启应用，提高开发效率 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- Spring Boot Mail Starter: 提供邮件发送功能 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- Spring Security插件：密码加密、哈希与数据脱敏 -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!-- 提供Spring框架的核心功能，如IOC容器、AOP、事务管理等 -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
		</dependency>

		<!--  数据库相关  -->
		<!-- MyBatis Plus Spring Boot 3 Starter: MyBatis增强工具，简化数据库操作，提供代码生成器、分页插件、性能分析等功能 -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-extension</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<!-- MySQL Connector/J: MySQL数据库的官方Java驱动程序，用于连接和操作MySQL数据库 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Druid Spring Boot 3 Starter: 阿里巴巴开源的高性能数据库连接池，提供监控、防御SQL注入等功能 -->
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>druid-spring-boot-3-starter</artifactId>
			<version>1.2.20</version>
		</dependency>


		<!--  工具库  -->
		<!-- EasyExcel: 阿里巴巴开源的Excel处理工具，支持大文件读取写入，内存占用低，性能优越 -->
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>easyexcel</artifactId>
			<version>3.3.4</version>
			<exclusions>
				<!-- 排除easyexcel自带的旧版poi-ooxml-schemas，避免与poi-ooxml 5.x版本冲突 -->
				<exclusion>
					<groupId>org.apache.poi</groupId>
					<artifactId>poi-ooxml-schemas</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Hutool All: 国产Java工具库，包含文件操作、日期处理、加密解密、HTTP客户端等丰富工具类 -->
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-all</artifactId>
			<version>5.8.32</version>
		</dependency>
		<!-- Java JWT: JSON Web Token的Java实现，用于生成和验证JWT令牌，实现无状态身份验证 -->
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.4.0</version>
		</dependency>
		<!-- 提供Java EE/Jakarta EE标准的注解 -->
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
		</dependency>
		<!-- Apache POI OOXML: Apache开源的Office文档处理库，支持读写Excel、Word、PowerPoint等Office文档 -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.5</version>
		</dependency>
		<!-- JSON序列化/反序列化 -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!-- Fastjson: 阿里巴巴的JSON处理库 -->
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>fastjson</artifactId>
			<version>1.2.83</version>
		</dependency>
		<!-- Dotenv: 用于加载环境变量的库，支持从文件加载环境变量，方便在不同环境下配置 -->
		<dependency>
			<groupId>io.github.cdimascio</groupId>
			<artifactId>java-dotenv</artifactId>
			<version>5.2.2</version>
		</dependency>

		<!--  代码生成和简化  -->
		<!-- Lombok: 通过注解自动生成Java代码，如getter/setter、构造函数、toString等方法，减少样板代码 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- SpotBugs Annotations: 提供代码缺陷检测的注解支持，如@SuppressFBWarnings -->
		<dependency>
			<groupId>com.github.spotbugs</groupId>
			<artifactId>spotbugs-annotations</artifactId>
			<version>4.8.6</version>
			<scope>provided</scope>
		</dependency>
		<!-- JSR305: 提供空值检查注解，如@Nullable、@Nonnull等 -->
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>3.0.2</version>
			<scope>provided</scope>
		</dependency>
		<!-- MapStruct: 对象映射框架，在编译时生成类型安全的Bean转换代码，性能优于反射方式 -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>1.5.5.Final</version>
		</dependency>
		<!-- MapStruct Processor: MapStruct的注解处理器，用于在编译时生成映射代码 -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct-processor</artifactId>
			<version>1.5.5.Final</version>
			<scope>provided</scope>
		</dependency>
		<!-- Lombok MapStruct Binding: 解决Lombok和MapStruct在编译时的执行顺序问题，确保两者能协同工作 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok-mapstruct-binding</artifactId>
			<version>0.2.0</version>
			<scope>provided</scope>
		</dependency>



		<!--  对象存储  -->
		<!-- 阿里云 OSS SDK: 阿里云对象存储服务的Java SDK，用于文件上传、下载、管理等操作 -->
		<dependency>
			<groupId>com.aliyun.oss</groupId>
			<artifactId>aliyun-sdk-oss</artifactId>
			<version>3.10.2</version>
		</dependency>
		<!-- MinIO Java SDK: MinIO对象存储的Java客户端，用于与MinIO兼容的S3对象存储服务交互 -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.5.7</version>
		</dependency>

		<!--  文档和其他  -->
		<!-- SpringDoc OpenAPI Starter WebMVC UI: 基于OpenAPI 3规范自动生成API文档，提供Swagger UI界面 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- Spring Session Data Redis: 将会话数据存储到Redis中，实现分布式会话管理，支持集群部署 -->
		<dependency>
			<groupId>org.springframework.session</groupId>
			<artifactId>spring-session-data-redis</artifactId>
		</dependency>
		<!-- IP2Region: IP地址定位库，支持将IP地址转换为国家、省份、城市等地理位置信息 -->
		<dependency>
			<groupId>org.lionsoul</groupId>
			<artifactId>ip2region</artifactId>
			<version>${ip2region.version}</version>
		</dependency>
		<!-- Simple Logging Facade for Java，提供统一的日志API -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<!--  安全相关（根据实际需要） -->
		<!-- Bouncy Castle JCE Provider: 密码学库，提供RSA、AES、SM2/SM3/SM4等国密算法支持 -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.78</version>
		</dependency>
		<!-- Apache Santuario XML Security: XML数字签名和加密库，用于处理XML文档的安全保护 -->
		<dependency>
			<groupId>org.apache.santuario</groupId>
			<artifactId>xmlsec</artifactId>
			<version>3.0.4</version>
		</dependency>
	</dependencies>

	<!-- 编译器插件配置 -->
	<build>
		<plugins>
			<!-- Maven 编译器插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>  <!-- 保持版本控制 -->
				<configuration>
					<!-- 使用Maven属性，保持灵活性 -->
					<source>${java.version}</source>
					<target>${java.version}</target>
					<encoding>${project.build.sourceEncoding}</encoding>
					<parameters>true</parameters>
					<!-- 注解处理器配置 -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>0.2.0</version>
						</path>
					</annotationProcessorPaths>
					<!-- 编译器参数 -->
					<compilerArgs>
						<!-- 基础参数 -->
						<arg>-parameters</arg>
						<arg>-Xlint:all</arg>
						<!-- 可选：排除某些警告 -->
						<arg>-Xlint:-serial</arg>
						<arg>-Xlint:-processing</arg>
						<!-- 解决注释处理不适用于隐式编译的文件的警告 -->
						<arg>-implicit:none</arg>
					</compilerArgs>
					<!-- 显示配置 -->
					<showWarnings>true</showWarnings>
					<showDeprecation>true</showDeprecation>
					<verbose>false</verbose>  <!-- 生产环境可设为false -->
				</configuration>
			</plugin>

			<!-- Spring Boot 打包插件 -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- SpotBugs 代码缺陷检测插件（已禁用）如需启用，请取消下方注释并配置 spotbugs-exclude.xml -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.8.6.0</version>
				<executions>
					<execution>
						<id>spotbugs.check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
							<goal>spotbugs</goal>
						</goals>
						<configuration>
							<skip>${spotbugs.skip}</skip>
							<failOnError>false</failOnError>
							<threshold>medium</threshold>
						</configuration>
					</execution>
				</executions>
				<configuration>
					<skip>${spotbugs.skip}</skip>
					<effort>max</effort>
					<threshold>low</threshold>
					<outputDirectory>${project.build.directory}</outputDirectory>
					<outputFormats>
						<outputFormat>xml</outputFormat>
						<outputFormat>html</outputFormat>
					</outputFormats>
					<excludeFilterFile>src/main/resources/spotbugs-exclude.xml</excludeFilterFile>
					<jvmArgs>--add-opens java.base/java.lang=ALL-UNNAMED</jvmArgs>
					<excludeSources>
						<excludeSource>generated-sources</excludeSource>
						<excludeSource>test</excludeSource>
					</excludeSources>
					<excludeClasses>
						<excludeClass>generated</excludeClass>
						<excludeClass>*Test.class</excludeClass>
					</excludeClasses>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs</artifactId>
						<version>4.8.6</version>
					</dependency>
				</dependencies>
			</plugin>
			

			<!-- Maven 依赖分析插件  -->
			<!-- <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>check-dependencies</id>
						&lt;!&ndash; 绑定到compile阶段执行 &ndash;&gt;
						<phase>compile</phase>
						<goals>
							&lt;!&ndash; 分析依赖（仅检测，不中断构建） &ndash;&gt;
							<goal>analyze-only</goal>
						</goals>
						<configuration>
							&lt;!&ndash; 依赖警告不中断构建（仅提示） &ndash;&gt;
							<failOnWarning>false</failOnWarning>
							&lt;!&ndash; 输出详细依赖分析日志到控制台 &ndash;&gt;
							<verbose>true</verbose>
						</configuration>
					</execution>
				</executions>
			</plugin> -->

		</plugins>
	</build>
</project>
